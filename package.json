{
  "name": "@grammyjs/testing",
  "version": "0.7.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./low-level": {
      "import": {
        "types": "./dist/low-level.d.ts",
        "default": "./dist/low-level.js"
      },
      "require": {
        "types": "./dist/low-level.d.cts",
        "default": "./dist/low-level.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "lint": "cross-env TIMING=1 npx eslint",
    "lint:fix": "npm run lint -- --fix",
    "lint:debug": "npm run lint -- --debug",
    "format:md": "npx prettier --write \"**/*.md\"",
    "typecheck": "npx tsc --noEmit",
    "test": "npx vitest",
    "test:run": "npx vitest run",
    "test:cjs": "node -e \"const t=require('./dist/index.cjs');const ll=require('./dist/low-level.cjs');[t.prepareBot,t.OutgoingRequests,t.mockSession,ll.MessagePrivateMockUpdate].forEach(f=>{if(typeof f!=='function')throw new Error('CJS export missing: '+f)});console.log('CJS exports OK')\"",
    "test:coverage": "npx vitest run --coverage",
    "bump-version": "npx tsx ./scripts/bump-version.script.ts && npm audit fix",
    "parse-llm-response": "npx tsx ./scripts/split-plain-code.wrap.ts",
    "after-parse-llm-response": "npx tsx ./scripts/create-auto-ts-paths.script.ts && npm run lint:fix && npm run format:md",
    "format": "npx prettier . --write",
    "postinstall": "./scripts/link-codex-skills.sh"
  },
  "keywords": [
    "grammy",
    "telegram",
    "bot",
    "testing",
    "test-framework",
    "vitest",
    "jest"
  ],
  "author": "Dmytro Vakulenko",
  "license": "MIT",
  "description": "Testing framework for grammY-based Telegram bots. Drives a real bot in-process, captures every outgoing API call, and dispatches synthetic updates.",
  "peerDependencies": {
    "grammy": "^1.42.0"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "type-fest": "^5.6.0"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.1.30",
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@grammyjs/chat-members": "^1.2.0",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/parse-mode": "^2.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/eslint-plugin": "^1.6.16",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-naming": "^1.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-lintlord": "^1.1.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-no-barrel-files": "^1.3.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "grammy": "^1.42.0",
    "json5": "^2.2.3",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "eslint-config-airbnb-base": {
      "eslint": "^10"
    },
    "eslint-plugin-promise": {
      "eslint": "^10"
    },
    "eslint-plugin-import": {
      "eslint": "^10"
    },
    "eslint-config-naming": {
      "typescript": "^6"
    },
    "eslint-plugin-lintlord": {
      "typescript": "^6"
    }
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git@github-personal:DrSmile444/typescript-boilerplate.git"
  }
}
